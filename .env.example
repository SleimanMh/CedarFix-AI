# CedarFix AI local development configuration.
# Copy this file to .env and fill the provider keys/endpoints you use.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=cedarfix
POSTGRES_PASSWORD=cedarfix_secret
POSTGRES_DB=cedarfix
# Container default. For host-side scripts, use:
# postgresql://cedarfix:cedarfix_secret@localhost:5432/cedarfix
DATABASE_URL=postgresql://cedarfix:cedarfix_secret@postgres:5432/cedarfix

# ---------------------------------------------------------------------------
# Internal service URLs
# Docker Compose sets these directly for grouped containers. These are useful
# when changing service topology. If running all services directly on the host,
# change ai-service/vision-service hostnames below to localhost.
# ---------------------------------------------------------------------------
TEXT_SERVICE_URL=http://ai-service:8001
IMAGE_SERVICE_URL=http://vision-service:8002
EMBEDDING_SERVICE_URL=http://ai-service:8003
CLUSTERING_SERVICE_URL=http://ai-service:8004
PRIORITY_SERVICE_URL=http://localhost:8005
ROUTING_SERVICE_URL=http://ai-service:8006
EXPLANATION_SERVICE_URL=http://localhost:8007
REVIEW_SERVICE_URL=http://localhost:8008

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=cedarfix-dev-secret-change-in-prod
JWT_EXPIRE_HOURS=24
# Legacy/admin registration hook. The current capstone-demo register path
# accepts role=admin directly, so this is not required for local runs.
ADMIN_REGISTRATION_SECRET=

# ---------------------------------------------------------------------------
# Text, routing, splitter, moderation, duplicate judge
# QWEN_BASE_URL should point to an OpenAI-compatible hosted Qwen endpoint.
# ---------------------------------------------------------------------------
QWEN_BASE_URL=http://host.docker.internal:8000/v1
QWEN_MODEL=cedarfix
QWEN_API_KEY=none
QWEN_ENABLED=true
QWEN_GUIDED=false
QWEN_TIMEOUT=50
QWEN_MAX_ATTEMPTS=1
QWEN_MAX_TOKENS=1536
QWEN_ROUTING_TIMEOUT=20
QWEN_ROUTING_MAX_TOKENS=512

# ---------------------------------------------------------------------------
# OpenAI fallback and evaluation judge
# Used for Arabizi translation, text fallback extraction, OpenAI-compatible
# media-alignment fallback, VLM-path image fallback, and optional evaluation.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Vision-language model
# VLM_BASE_URL should point to an OpenAI-compatible hosted Qwen VLM endpoint.
# ---------------------------------------------------------------------------
VLM_BASE_URL=
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VLM_API_KEY=none
VLM_ENABLED=true
VLM_TIMEOUT=25

# ---------------------------------------------------------------------------
# Text/image alignment judge
# Defaults can reuse the Qwen text endpoint. Set API key/base URL if different.
# ---------------------------------------------------------------------------
MEDIA_ALIGNMENT_LLM_ENABLED=true
MEDIA_ALIGNMENT_MODEL=cedarfix
MEDIA_ALIGNMENT_API_KEY=none
MEDIA_ALIGNMENT_BASE_URL=http://host.docker.internal:8000/v1
MEDIA_ALIGNMENT_TIMEOUT=20
MEDIA_ALIGNMENT_MIN_CONFIDENCE=0.55

# ---------------------------------------------------------------------------
# Storage
# local = Docker volume at /data/uploads.
# gcs = Google Cloud Storage bucket configured by GCS_BUCKET.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
GCS_BUCKET=
UPLOADS_DIR=/data/uploads

# ---------------------------------------------------------------------------
# Qdrant vector database
# Local Docker Compose uses QDRANT_HOST/QDRANT_PORT.
# Cloud deployments can set QDRANT_URL and QDRANT_API_KEY.
# ---------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=20
QDRANT_PREFER_GRPC=false
QDRANT_TEXT_COLLECTION=text_embeddings
QDRANT_CLIP_COLLECTION=clip_embeddings
ROUTING_QDRANT_COLLECTION=routing_knowledge

# ---------------------------------------------------------------------------
# Model names and dimensions
# ---------------------------------------------------------------------------
MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
TEXT_EMBEDDING_DIM=768
CLIP_EMBEDDING_DIM=512
AUGMENT_TEXT_EMBEDDING_WITH_IMAGE_CAPTION=true
STORE_IMAGE_CANDIDATE_EMBEDDINGS=true
CAPTION_AUGMENT_CONFIDENCE_THRESHOLD=0.55

# ---------------------------------------------------------------------------
# Routing, duplicate detection, priority, moderation
# ---------------------------------------------------------------------------
ROUTING_RAG_ENABLED=true
ROUTING_RAG_TOP_K=8
ROUTING_RAG_STAGE_PRIORITY_ENABLED=true
ROUTING_RAG_STAGE1_TARGET=12
ROUTING_RAG_STAGE2_TARGET=8
ROUTING_RAG_STAGE3_TARGET=6
ROUTING_STATIC_FALLBACK_ENABLED=false
AUTO_ROUTE_THRESHOLD=0.85
REVIEW_THRESHOLD=0.65
LLM_JUDGE_ENABLED=true
LLM_JUDGE_TIMEOUT=8
MODERATION_ENABLED=true
MODERATION_LLM_THRESHOLD=0.75
MODE=template

# ---------------------------------------------------------------------------
# Location normalization
# GOOGLE_MAPS_API_KEY is optional. Without it, seeded/fuzzy lookup is used.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
NOMINATIM_URL=

# ---------------------------------------------------------------------------
# Complaint splitting
# ---------------------------------------------------------------------------
MULTI_COMPLAINT_SPLITTER_ENABLED=true
MULTI_COMPLAINT_SPLITTER_LLM_ENABLED=true
MULTI_COMPLAINT_SPLITTER_MAX_CHILDREN=5
MULTI_COMPLAINT_SPLITTER_TIMEOUT=12

# ---------------------------------------------------------------------------
# RAG and municipality seed scripts
# ---------------------------------------------------------------------------
ROUTING_KNOWLEDGE_DOCS=RAG Data/compiled/routing_knowledge_compiled_production.json
MUNICIPALITY_LOOKUP_DOCS=RAG Data/municipality/municipality_lookup_compiled_production.json
ROUTING_SEED_EMBED_BATCH_SIZE=64
ROUTING_QDRANT_UPLOAD_BATCH_SIZE=128
ROUTING_QDRANT_UPLOAD_PARALLEL=2
ROUTING_QDRANT_UPLOAD_MAX_RETRIES=5
ROUTING_QDRANT_UPLOAD_WAIT=false
MUNICIPALITY_QDRANT_UPLOAD_BATCH_SIZE=128
MUNICIPALITY_QDRANT_UPLOAD_PARALLEL=2
MUNICIPALITY_QDRANT_UPLOAD_MAX_RETRIES=5
MUNICIPALITY_QDRANT_UPLOAD_WAIT=false
QDRANT_VERIFY_AFTER_UPLOAD=true

# ---------------------------------------------------------------------------
# Audit, MLflow, Prometheus, Grafana, evaluation
# ---------------------------------------------------------------------------
LLM_AUDIT_ENABLED=true
LLM_AUDIT_GCS_ENABLED=false
LLM_AUDIT_GCS_PREFIX=llm-audit
LLM_AUDIT_MAX_JSON_CHARS=50000
LLM_AUDIT_MAX_RAW_CHARS=50000
MLFLOW_TRACKING_URI=http://mlflow:5000
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=cedarfix_grafana
EVALUATION_JUDGE_MODEL=gpt-4o
EVALUATION_SCHEDULER_ENABLED=true
EVALUATION_RUN_ON_STARTUP=false
EVALUATION_TIMEZONE=Asia/Beirut
EVALUATION_SAMPLE_RATE=0.20
EVALUATION_BATCH_SIZE=4
EVALUATION_REQUEST_TIMEOUT=90
EVALUATION_BATCH_DELAY_SECONDS=20
EVALUATION_MAX_RETRIES=3
EVALUATION_MAX_TOKENS=4096
EVALUATION_INCLUDE_IMAGE_PARTS=false
