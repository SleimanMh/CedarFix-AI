# CedarFix — environment variables template
# Copy to .env and fill in real values.  Never commit .env.

# PostgreSQL
POSTGRES_USER=cedarfix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cedarfix

# Service connection strings (used by EEP and IEPs)
DATABASE_URL=postgresql+asyncpg://cedarfix:CHANGE_ME@postgres:5432/cedarfix
REDIS_URL=redis://redis:6379/0

# IEP-4 — LLM provider (OpenAI-compatible)
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
IEP4_MODEL=gpt-4o-mini

# MLflow tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
