{
  "type": "object",
  "properties": {
    "is_complaint": { "type": "boolean" },
    "english_translation": { "type": "string" },
    "issue_type": { "type": "string" },
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "location_mentions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "signals": {
      "type": "object",
      "properties": {
        "public_safety_risk": { "type": "boolean" },
        "traffic_impact": { "type": "boolean" },
        "corruption_signal": { "type": "boolean" },
        "emergency_signal": { "type": "boolean" }
      },
      "required": [
        "public_safety_risk",
        "traffic_impact",
        "corruption_signal",
        "emergency_signal"
      ]
    },
    "routing_features": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "physical_component": { "type": "string" },
        "failure_mode": { "type": "string" },
        "hazard_type": { "type": "string" },
        "affected_public_space": { "type": "boolean" },
        "requires_emergency_attention": { "type": "boolean" }
      },
      "required": [
        "domain",
        "physical_component",
        "failure_mode",
        "hazard_type",
        "affected_public_space",
        "requires_emergency_attention"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "text_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["text_evidence", "image_evidence", "missing_information"]
    },
    "alignment_features": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "physical_component": { "type": "string" },
        "failure_mode": { "type": "string" },
        "visible_hazard": { "type": "boolean" },
        "objects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "location_context": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "domain",
        "physical_component",
        "failure_mode",
        "visible_hazard",
        "objects",
        "actions",
        "location_context"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "semantic_domain": { "type": "string" },
    "physical_component": { "type": "string" },
    "failure_mode": { "type": "string" }
  },
  "required": [
    "is_complaint",
    "english_translation",
    "issue_type",
    "category",
    "subcategory",
    "severity",
    "location_mentions",
    "keywords",
    "summary",
    "signals",
    "routing_features",
    "evidence",
    "alignment_features",
    "confidence",
    "semantic_domain",
    "physical_component",
    "failure_mode"
  ]
}
